# Copy this file to .env for local development.
# Never put real credentials in this example file.

APP_ENV=development

# Keep false for the free analytics-only portfolio deployment.
AI_FEATURES_ENABLED=false

# Required only when enabling Executive Summary, Recommendations, and Ask Your Data.
ANTHROPIC_API_KEY=

# Optional. This is the current default model used by InsightIQ.
CLAUDE_MODEL=claude-sonnet-5
